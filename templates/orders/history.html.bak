{% extends "base_staff.html" %}
{% block title %}Historique commandes — Saveur 237{% endblock %}
{% block content %}
<div class="section-title">
  <div>
    <p class="badge" style="background:rgba(0,135,81,0.12);color:var(--green);">Orders</p>
    <h2>Historique des commandes</h2>
    <p class="muted">Commandes terminees et payees.</p>
  </div>
  {% if is_manager %}
    <a class="btn" href="{% url 'reports:dashboard' %}">Rapports</a>
  {% endif %}
</div>

<div class="card" style="margin-top:12px;">
  <table class="ord-table">
    <thead>
      <tr>
        <th>N°</th><th>Type</th>{% if is_cashier or is_manager %}<th>Total</th>{% endif %}<th>Date</th><th>Statut</th>
      </tr>
    </thead>
    <tbody>
      {% for o in orders %}
        <tr><td>#{{ o.id }}</td><td>{{ o.get_order_type_display }}</td>{% if is_cashier or is_manager %}<td>{{ o.total_amount }}</td>{% endif %}<td>{{ o.created_at|date:"d/m" }}</td><td><span class="pill pill-ok">{{ o.get_status_display }}</span></td></tr>
      {% empty %}
        <tr><td colspan="5">Aucune commande.</td></tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endblock %}
