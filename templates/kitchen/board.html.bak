{% extends "base_staff.html" %}
{% block title %}Cuisine — KDS{% endblock %}
{% block content %}
<style>
  .kds-head{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;}
  .kds-stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:10px;}
  .kpi{border:2px solid #111;border-radius:12px;padding:12px;background:#fff;text-decoration:none;color:#111;display:block;}
  .kpi strong{font-size:18px;display:block;}
  .kpi .num{font-size:28px;font-weight:800;}
  .kpi.pending{border-color:#f1c40f;}
  .kpi.prep{border-color:#2d74da;}
  .kpi.ready{border-color:#008751;}
  .ticket-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:12px;}
  .cols{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
  @media(max-width:1100px){.cols{grid-template-columns:1fr;}}
  .col-title{font-size:18px;font-weight:800;margin:0 0 8px;}
  .flash{animation:flash 0.7s ease-in-out 3;}
  @keyframes flash{0%{background:#fff;}50%{background:#fff3cd;}100%{background:#fff;}}
  .ticket{border:3px solid #111;border-radius:14px;padding:14px;background:#fff;box-shadow:0 12px 24px rgba(0,0,0,0.08);}
  .ticket h3{margin:0;font-size:22px;}
  .ticket .meta{font-size:13px;color:#333;font-weight:600;}
  .badge-pending{background:#f1c40f;color:#111;} 
  .badge-prep{background:#2d74da;color:#fff;} 
  .badge-ready{background:#008751;color:#fff;} 
  .badge-issue{background:#ce1126;color:#fff;} 
  .item{display:flex;justify-content:space-between;gap:8px;border-bottom:1px dashed #ddd;padding:6px 0;font-size:15px;}
  .note{border-left:4px solid #ce1126;padding:6px 10px;background:#fff4f4;border-radius:8px;font-weight:700;color:#8a0f1e;}
  .chip{border:2px solid #111;background:#fff;padding:6px 12px;border-radius:999px;font-weight:700;font-size:13px;text-decoration:none;color:#111;}
  .chip.active{background:#111;color:#fff;} 
  .kds-actions{display:flex;gap:10px;flex-wrap:wrap;align-items:center;}
</style>

<div class="kds-head">
  <div>
    <p class="badge" style="background:rgba(0,135,81,0.12);color:var(--green);">Cuisine</p>
    <h2>Cuisine — KDS</h2>
    <p class="muted">Tickets en temps réel.</p>
  </div>
  <div class="kds-stats">
    <a class="kpi pending" href="{% url 'kitchen:board' %}?status=EN_ATTENTE">
      <strong>EN ATTENTE</strong><div class="num">{{ count_pending }}</div>
    </a>
    <a class="kpi prep" href="{% url 'kitchen:board' %}?status=PREPARATION">
      <strong>EN PRÉPARATION</strong><div class="num">{{ count_preparing }}</div>
    </a>
    <a class="kpi ready" href="{% url 'kitchen:history' %}">
      <strong>PRÊTES</strong><div class="num">{{ count_ready }}</div>
    </a>
  </div>
</div>

<div class="card" style="margin:12px 0;">
  <div class="kds-actions">
    <a class="chip {% if not status_filter %}active{% endif %}" href="{% url 'kitchen:board' %}">Tous</a>
    <a class="chip {% if status_filter == 'EN_ATTENTE' %}active{% endif %}" href="{% url 'kitchen:board' %}?status=EN_ATTENTE">EN ATTENTE</a>
    <a class="chip {% if status_filter == 'PREPARATION' %}active{% endif %}" href="{% url 'kitchen:board' %}?status=PREPARATION">EN PRÉPARATION</a>
    <a class="chip {% if source_filter == 'TABLE' %}active{% endif %}" href="{% url 'kitchen:board' %}?source=TABLE">TABLE</a>
    <a class="chip {% if source_filter == 'ONLINE' %}active{% endif %}" href="{% url 'kitchen:board' %}?source=ONLINE">ONLINE</a>
    <a class="chip" href="{% url 'kitchen:bar' %}">BAR</a>
    <button class="chip" type="button" onclick="toggleFullscreen()">PLEIN ÉCRAN</button>
  </div>
</div>

<div class="cols">
  <div>
    <p class="col-title">Serveur (Sur place / À emporter) — {{ count_server }}</p>
    <div class="ticket-grid">
      {% for o in kitchen_orders %}
      {% if o.order_type != 'delivery' %}
      <div class="ticket">
    <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;">
      <h3>#{{ o.id }}</h3>
      {% if o.status == 'EN_ATTENTE' %}<span class="badge badge-pending">EN ATTENTE</span>{% endif %}
      {% if o.status == 'PREPARATION' %}<span class="badge badge-prep">EN PRÉPARATION</span>{% endif %}
    </div>
    <div class="meta">
      #{{ o.id }} • {{ o.get_order_type_display }}{% if o.order_type == 'dine_in' %} • Table {{ o.table.name }}{% endif %}
      • {{ o.created_at|date:"H:i" }}
    </div>
    <div style="margin-top:8px;">
      {% for item in o.items.all %}
        <div class="item">
          <span>{{ item.dish.name }} x{{ item.quantity }}</span>
          {% if item.note %}<span class="note">{{ item.note }}</span>{% endif %}
        </div>
      {% endfor %}
    </div>
    {% if o.note %}
      <div class="note" style="margin-top:8px;">{{ o.note }}</div>
    {% endif %}
    {% if o.kitchen_issue %}
      <div class="badge badge-issue" style="margin-top:8px;">⚠ Problème signalé</div>
    {% endif %}
    {% if o.kitchen_updates.count %}
      <div class="badge" style="margin-top:8px;">AJOUT / MODIF</div>
    {% endif %}
    <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:10px;">
      {% if o.status == 'EN_ATTENTE' %}
        <form method="post" action="{% url 'kitchen:action' o.id %}">
          {% csrf_token %}
          <input type="hidden" name="action" value="start">
          {% if is_cook or is_manager %}
            <button class="btn-outline" type="submit">Commencer</button>
          {% else %}
            <span class="muted">Accès restreint</span>
          {% endif %}
        </form>
      {% endif %}
      {% if o.status == 'PREPARATION' %}
        <form method="post" action="{% url 'kitchen:action' o.id %}">
          {% csrf_token %}
          <input type="hidden" name="action" value="ready">
          {% if is_cook or is_manager %}
            <button class="btn" type="submit">Prête</button>
          {% else %}
            <span class="muted">Accès restreint</span>
          {% endif %}
        </form>
      {% endif %}
      <a class="btn-outline" href="{% url 'kitchen:ticket' o.id %}">Détail</a>
    </div>
  </div>
      {% endif %}
      {% empty %}
      <div class="card">Aucun ticket.</div>
      {% endfor %}
    </div>
  </div>
  <div>
    <p class="col-title">Coursier (Livraison) — {{ count_courier }}</p>
    <div class="ticket-grid">
      {% for o in kitchen_orders %}
      {% if o.order_type == 'delivery' %}
      <div class="ticket">
        <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;">
          <h3>#{{ o.id }}</h3>
          {% if o.status == 'EN_ATTENTE' %}<span class="badge badge-pending">EN ATTENTE</span>{% endif %}
          {% if o.status == 'PREPARATION' %}<span class="badge badge-prep">EN PRÉPARATION</span>{% endif %}
        </div>
        <div class="meta">
          #{{ o.id }} • {{ o.get_order_type_display }}{% if o.order_type == 'dine_in' %} • Table {{ o.table.name }}{% endif %}
          • {{ o.created_at|date:"H:i" }}
        </div>
        <div style="margin-top:8px;">
          {% for item in o.items.all %}
            {% if "boisson" in item.dish.category.name|lower %}
            <div class="item">
              <span>{{ item.dish.name }} x{{ item.quantity }}</span>
              {% if item.note %}<span class="note">{{ item.note }}</span>{% endif %}
            </div>
            {% endif %}
          {% endfor %}
        </div>
        {% if o.note %}
          <div class="note" style="margin-top:8px;">{{ o.note }}</div>
        {% endif %}
        <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:10px;">
          {% if o.status == 'EN_ATTENTE' %}
            <form method="post" action="{% url 'kitchen:action' o.id %}">
              {% csrf_token %}
              <input type="hidden" name="action" value="start">
              {% if is_cook or is_manager %}
                <button class="btn-outline" type="submit">Commencer</button>
              {% else %}
                <span class="muted">Accès restreint</span>
              {% endif %}
            </form>
          {% endif %}
          {% if o.status == 'PREPARATION' %}
            <form method="post" action="{% url 'kitchen:action' o.id %}">
              {% csrf_token %}
              <input type="hidden" name="action" value="ready">
              {% if is_cook or is_manager %}
                <button class="btn" type="submit">Prête</button>
              {% else %}
                <span class="muted">Accès restreint</span>
              {% endif %}
            </form>
          {% endif %}
          <a class="btn-outline" href="{% url 'kitchen:ticket' o.id %}">Détail</a>
        </div>
      </div>
      {% endif %}
      {% empty %}
      <div class="card">Aucun ticket.</div>
      {% endfor %}
    </div>
  </div>
</div>

<script>
  function toggleFullscreen(){
    if (!document.fullscreenElement) {
      document.documentElement.requestFullscreen();
    } else {
      document.exitFullscreen();
    }
  }
  (function(){
    const latest = Number("{{ latest_ticket_id }}");
    const key = "kds_latest_ticket_id";
    const prev = Number(localStorage.getItem(key) || "0");
    if (latest > prev) {
      document.body.classList.add("flash");
      try {
        const ctx = new (window.AudioContext || window.webkitAudioContext)();
        const o = ctx.createOscillator();
        const g = ctx.createGain();
        o.frequency.value = 880;
        o.connect(g);
        g.connect(ctx.destination);
        g.gain.value = 0.08;
        o.start();
        setTimeout(()=>{o.stop(); ctx.close();}, 180);
      } catch(e){}
    }
    if (latest > 0) localStorage.setItem(key, String(latest));
    setTimeout(()=>{location.reload();}, 20000);
  })();
</script>
{% endblock %}
