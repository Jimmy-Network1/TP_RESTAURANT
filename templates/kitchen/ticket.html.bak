{% extends "base_staff.html" %}
{% block title %}Ticket cuisine #{{ order.id }}{% endblock %}
{% block content %}
<style>
  .ticket-shell{max-width:820px;margin:0 auto;}
  .ticket-card{border:2px solid #111;border-radius:16px;background:#fff;padding:16px;box-shadow:0 10px 24px rgba(0,0,0,0.08);}
  .ticket-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;flex-wrap:wrap;}
  .ticket-meta{display:grid;gap:4px;font-size:13px;color:#444;}
  .ticket-title{margin:0;font-size:24px;letter-spacing:0.4px;}
  .badge-pending{background:#f1c40f;color:#111;}
  .badge-prep{background:#2d74da;color:#fff;}
  .badge-ready{background:#008751;color:#fff;}
  .badge-issue{background:#ce1126;color:#fff;}
  .divider{border:none;border-top:1px dashed #cfcfcf;margin:12px 0;}
  .items{display:grid;gap:8px;}
  .item-row{display:grid;grid-template-columns:1fr auto;gap:10px;align-items:center;border:1px solid #e6e6e6;border-radius:10px;padding:10px 12px;background:#fff;}
  .item-name{font-weight:700;}
  .item-qty{font-weight:700;font-size:16px;}
  .note{border-left:4px solid #ce1126;padding:6px 10px;background:#fff4f4;border-radius:8px;font-weight:700;color:#8a0f1e;}
  .actions{display:grid;gap:8px;}
  .updates{display:grid;gap:6px;}
  @media print{
    .btn,.btn-outline,.topbar,.sidebar,.nav,.actions,.back-btn{display:none !important;}
    .ticket-card{box-shadow:none;border:1px solid #111;}
    body{background:#fff;}
  }
</style>

<div class="ticket-shell">
  <div class="ticket-card">
    <div class="ticket-head">
      <div>
        <p class="badge" style="background:rgba(0,135,81,0.12);color:var(--green);">Cuisine</p>
        <h2 class="ticket-title">Ticket #{{ order.id }}</h2>
        <div class="ticket-meta">
          <span>#{{ order.id }} • {{ order.get_order_type_display }}{% if order.order_type == 'dine_in' %} • Table {{ order.table.name }}{% endif %}</span>
          <span>Créé : {{ order.created_at|date:"d/m H:i" }}</span>
          {% if order.created_by %}<span>Serveur : {{ order.created_by.username }}</span>{% endif %}
        </div>
      </div>
      <div style="display:flex;gap:8px;align-items:center;">
        {% if order.status == 'EN_ATTENTE' %}<span class="badge badge-pending">EN ATTENTE</span>{% endif %}
        {% if order.status == 'PREPARATION' %}<span class="badge badge-prep">EN PRÉPARATION</span>{% endif %}
        {% if order.status == 'PRETE' %}<span class="badge badge-ready">PRÊTE</span>{% endif %}
      </div>
    </div>

    <hr class="divider">

    <div class="items">
      {% for item in items %}
      <div class="item-row">
        <div>
          <div class="item-name">{{ item.dish.name }}</div>
          {% if item.note %}<div class="note" style="margin-top:6px;">{{ item.note }}</div>{% endif %}
        </div>
        <div class="item-qty">x{{ item.quantity }}</div>
      </div>
      {% endfor %}
    </div>

    {% if order.note %}
      <div class="note" style="margin-top:10px;">{{ order.note }}</div>
    {% endif %}

    <hr class="divider">

    <div class="grid">
      <div class="card">
        <h4>Actions</h4>
        <div class="actions">
          <a class="btn-outline" href="javascript:window.print()">Imprimer ticket</a>
          {% if order.status == 'EN_ATTENTE' %}
            <form method="post" action="{% url 'kitchen:action' order.id %}">
              {% csrf_token %}
              <input type="hidden" name="action" value="start">
              {% if is_cook or is_manager %}
                <button class="btn-outline" type="submit">Commencer</button>
              {% else %}
                <span class="muted">Accès restreint</span>
              {% endif %}
            </form>
          {% endif %}
          {% if order.status == 'PREPARATION' %}
            <form method="post" action="{% url 'kitchen:action' order.id %}">
              {% csrf_token %}
              <input type="hidden" name="action" value="ready">
              {% if is_cook or is_manager %}
                <button class="btn" type="submit">Marquer prête</button>
              {% else %}
                <span class="muted">Accès restreint</span>
              {% endif %}
            </form>
          {% endif %}
        </div>
        <hr style="border:none;border-top:1px solid #eee;margin:12px 0;">
        <form method="post" action="{% url 'kitchen:action' order.id %}">
          {% csrf_token %}
          <input type="hidden" name="action" value="issue">
          <div class="form-row">
            <label>Signaler un problème</label>
            <input class="form-control" name="note" maxlength="200" placeholder="Rupture, clarification, etc.">
          </div>
          <button class="btn-outline" type="submit">Notifier manager</button>
        </form>
        {% if order.kitchen_issue %}
          <p class="badge badge-issue" style="margin-top:8px;">⚠ {{ order.kitchen_issue_note }}</p>
        {% endif %}
      </div>

      <div class="card">
        <h4>Ajouts / modifications</h4>
        <div class="updates">
          {% for u in updates %}
            <div class="item-row">
              <span>{{ u.get_kind_display }} — {{ u.note|default:'Ajout après envoi' }}</span>
              <span class="muted">{{ u.created_at|date:"H:i" }}</span>
            </div>
          {% empty %}
            <p class="muted">Aucun ajout.</p>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}
