{% extends "base_staff.html" %}
{% block title %}Historique cuisine — Saveur 237{% endblock %}
{% block content %}
<div class="section-title">
  <div>
    <p class="badge" style="background:rgba(0,135,81,0.12);color:var(--green);">Cuisine</p>
    <h2>Historique cuisine</h2>
    <p class="muted">Commandes prêtes.</p>
  </div>
</div>

<div class="card">
  <table>
    <thead>
      <tr>
        <th>Commande</th>
        <th>Source</th>
        <th>Heure</th>
        <th>Statut</th>
      </tr>
    </thead>
    <tbody>
      {% for o in orders %}
      <tr>
        <td>#{{ o.id }}</td>
        <td>{% if o.order_type == 'dine_in' %}TABLE{% else %}ONLINE{% endif %}</td>
        <td>{{ o.created_at|date:"d/m H:i" }}</td>
        <td>{{ o.get_status_display }}</td>
      </tr>
      {% empty %}
      <tr><td colspan="4">Aucune donnée.</td></tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endblock %}
