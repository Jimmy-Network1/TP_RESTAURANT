{% extends "base_staff.html" %}
{% block title %}Caisse — Saveur 237{% endblock %}
{% block content %}
<style>
  .cash-head{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;}
  .cash-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px;}
  .cash-card{border:1px solid #eee;border-radius:16px;background:#fff;padding:14px;box-shadow:0 12px 24px rgba(0,0,0,0.06);} 
</style>

<div class="cash-head">
  <div>
    <p class="badge" style="background:rgba(0,135,81,0.12);color:var(--green);">Caisse</p>
    <h2>Ouverture / fermeture</h2>
    <p class="muted">Suivi des sessions de caisse.</p>
  </div>
  <div style="display:flex;gap:8px;flex-wrap:wrap;">
    {% if is_cashier or is_manager %}
      {% if session %}
        <form method="post">
          {% csrf_token %}
          <input type="hidden" name="action" value="close">
          <input class="form-control" type="number" step="0.01" name="closing_amount" placeholder="Montant de clôture">
          <button class="btn-outline" type="submit">Fermer caisse</button>
        </form>
      {% else %}
        <form method="post">
          {% csrf_token %}
          <input type="hidden" name="action" value="open">
          <input class="form-control" type="number" step="0.01" name="opening_amount" placeholder="Montant initial">
          <button class="btn" type="submit">Ouvrir caisse</button>
        </form>
      {% endif %}
    {% else %}
      <span class="muted">Accès réservé au caissier/gerant.</span>
    {% endif %}
  </div>
</div>

<div class="cash-grid" style="margin-top:12px;">
  <div class="cash-card">
    <div class="muted">État</div>
    <div style="font-size:20px;font-weight:800;">{% if session %}Ouverte{% else %}Fermée{% endif %}</div>
  </div>
  <div class="cash-card">
    <div class="muted">Montant initial</div>
    <div style="font-size:20px;font-weight:800;">{{ session.opening_amount|default:"0" }} FCFA</div>
  </div>
  <div class="cash-card">
    <div class="muted">Paiements</div>
    <div style="font-size:20px;font-weight:800;">{{ totals.count|default:"0" }}</div>
  </div>
  <div class="cash-card">
    <div class="muted">Total encaissé</div>
    <div style="font-size:20px;font-weight:800;">{{ totals.sum|default:"0" }} FCFA</div>
  </div>
</div>

<div class="card" style="margin-top:12px;">
  <h4 style="margin-top:0;">Generer un resume</h4>
  <p class="muted">Export future (PDF / CSV).</p>
  <a class="btn" href="#">Generer resume</a>
</div>
{% endblock %}
